{
  "expo": {
    "name": "Sprout",
    "slug": "sprout-app",
    "version": "1.2.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "sproutapp",
    "userInterfaceStyle": "automatic",
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#12241A",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.organizma.sproutapp"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0F1813",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 180
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-sharing",
      "expo-notifications",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Sprout uses your location to check the local temperature and fine-tune watering reminders for the season."
        }
      ],
      "react-native-fast-tflite",
      [
        "react-native-android-widget",
        {
          "fonts": [
            "./assets/fonts/Ionicons.ttf"
          ],
          "widgets": [
            {
              "name": "TodaySmall",
              "label": "Sprout: Today",
              "description": "How many plants need water today",
              "minWidth": "110dp",
              "minHeight": "110dp",
              "targetCellWidth": 2,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000
            },
            {
              "name": "TodayMedium",
              "label": "Sprout: Today list",
              "description": "The plants waiting for water today",
              "minWidth": "250dp",
              "minHeight": "110dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000
            },
            {
              "name": "Plant",
              "label": "Sprout: One plant",
              "description": "One plant of your choice",
              "minWidth": "110dp",
              "minHeight": "110dp",
              "targetCellWidth": 2,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000,
              "widgetFeatures": "reconfigurable"
            },
            {
              "name": "Week",
              "label": "Sprout: This week",
              "description": "Waterings for the next seven days",
              "minWidth": "250dp",
              "minHeight": "110dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000
            },
            {
              "name": "Shortcuts",
              "label": "Sprout: Shortcuts",
              "description": "Identify a plant, light meter, add a plant",
              "minWidth": "250dp",
              "minHeight": "40dp",
              "targetCellWidth": 4,
              "targetCellHeight": 1,
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000
            }
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "updates": {
      "url": "https://u.expo.dev/3c8144d1-1573-4fd9-820f-70f8caa71969"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "3c8144d1-1573-4fd9-820f-70f8caa71969"
      }
    }
  }
}
